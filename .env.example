# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=
# Any of the allowed models works; gpt-4.1-mini is a good cost/quality default for planning.
OPENAI_MODEL=gpt-4.1-mini
# auto = LLM if a key is set, else keyword rules | llm | rules
PLANNER=auto
# Records fetched per dataset (per comparison group). Max 10000 per request via max_records.
MAX_RECORDS=5000
# Per-request timeout for ClinicalTrials.gov (large pages can take a while)
CTGOV_TIMEOUT_S=60
# Optional on-disk cache of API responses (reproducible demos, kinder to the public API)
CTGOV_CACHE_DIR=.cache/ctgov
CTGOV_CACHE_TTL_S=21600
